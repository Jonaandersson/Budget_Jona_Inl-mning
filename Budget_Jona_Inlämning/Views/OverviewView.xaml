<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:Budget_Jona_Inlämning.Helpers"
             mc:Ignorable="d"
             x:Class="Budget_Jona_Inlämning.Views.OverviewView"
             Language="sv-SE">
    <UserControl.Resources>
        <helpers:IncomeLossNetConverter x:Key="IncomeLossNetConverter"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Add Transaction" Command="{Binding AddTransactionCommand}" Margin="0,0,8,0" Style="{StaticResource ButtonPrimaryStyle}"/>
                <Button Content="Add IncomeLoss" Command="{Binding AddIncomeLossCommand}" Margin="0,0,8,0" Style="{StaticResource ButtonPrimaryStyle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="◀" Command="{Binding PrevMonthCommand}" Width="28" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SelectedMonthLabel}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0"/>
                    <Button Content="▶" Command="{Binding NextMonthCommand}" Width="28" Margin="0,0,6,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Income:" FontWeight="Bold" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding IncomeTotal, StringFormat=C}" Margin="0,0,12,0"/>
                    <TextBlock Text="Expense:" FontWeight="Bold" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding ExpenseTotal, StringFormat=C}" Margin="0,0,12,0"/>
                    <TextBlock Text="Net:" FontWeight="Bold" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding NetTotal, StringFormat=C}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Transactions + IncomeLoss  -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- transactions -->
                    <RowDefinition Height="320"/>
                    <!-- income/loss card -->
                </Grid.RowDefinitions>

                <!-- Transactions -->
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding FilteredTransactions}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                          VirtualizingPanel.IsVirtualizing="True"
                          EnableRowVirtualization="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VerticalAlignment="Stretch">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="120"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="150"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Income" Binding="{Binding IsIncome}" Width="70"/>
                        <DataGridCheckBoxColumn Header="Monthly" Binding="{Binding IsMonthly}" Width="70"/>
                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Command="{Binding DataContext.EditTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- IncomeLoss card  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,0,0" Height="320">
                    <StackPanel>
                        <TextBlock Text="Income Loss" Style="{StaticResource TitleTextBlock}" />
                        
                        <ListBox ItemsSource="{Binding IncomeLosses}"
                                 Height="260"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Standard"
                                 BorderThickness="0"
                                 Margin="0,2,0,2"
                                 Background="Transparent"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding Date, StringFormat=d}" Width="80"/>
                                            <TextBlock Text="{Binding AmountLost, StringFormat=C}" Width="100" HorizontalAlignment="Right"/>
                                            <TextBlock Text=" → " Margin="6,0"/>
                                            <TextBlock Text="{Binding RefundAmount, StringFormat=C}" Width="100" HorizontalAlignment="Right"/>
                                            
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Content="Edit"
                                                    Command="{Binding DataContext.EditIncomeLossCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource ButtonPrimaryStyle}"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DataContext.DeleteIncomeLossCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Separator Grid.Column="1" VerticalAlignment="Stretch" Margin="4,0"/>

            <!-- RIGHT: Categories + Projected -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Categories card (top) -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8" MaxHeight="420">
                    <StackPanel>
                        <TextBlock Text="Categories" Style="{StaticResource TitleTextBlock}" Margin="0,0,0,8"/>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="Add" Command="{Binding AddCategoryCommand}" Margin="0,0,8,0" Style="{StaticResource ButtonPrimaryStyle}"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Categories}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      MaxHeight="300"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Edit" Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
                                                    <Button Content="Delete" Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Projected card (under) -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8" MaxHeight="180">
                    <StackPanel>
                        <TextBlock Text="Projected (next month)" Style="{StaticResource TitleTextBlock}" />
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Income:" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ProjectedIncome, StringFormat=C}" Margin="0,0,12,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Expense:" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ProjectedExpense, StringFormat=C}" Margin="0,0,12,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Net:" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ProjectedNet, StringFormat=C}" Margin="0,0,12,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                
                <Border Grid.Row="2" Background="Transparent"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>